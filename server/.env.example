# Optional: makes organizing smart (Keeps, Plans, summaries, media folders, urgency).
# Without it Weave still works using simple keyword rules ("Basic mode").
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Optional: Google Drive backup (Weave/<chat>/<year>/<category>/...)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
WEB_URL=http://localhost:5173

# Optional: real SMS login codes via Twilio. Without these, codes print in the server console
# (and appear on the login screen) so you can test locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
